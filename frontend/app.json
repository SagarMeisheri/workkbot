{
  "expo": {
    "name": "workkbot",
    "slug": "workkbot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "workkbot",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workkbot.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.workkbot.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
