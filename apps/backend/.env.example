# Workkbot Backend Environment Configuration Template
# In local development: copy to .env and fill in real values
# In production (GCP Cloud Run): mounted directly from Google Cloud Secret Manager

ENVIRONMENT=development
BACKEND_PORT=8000

# Supabase (ap-south-1 Mumbai)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret-minimum-32-chars>

# Reviewer Sandbox (Apple Guideline 2.1)
REVIEWER_EMAIL=apple-reviewer@workkbot.in
REVIEWER_PASSWORD=<reviewer-password>
REVIEWER_ORG_ID=e0000000-0000-0000-0000-000000000002

# Agentgateway (Rust 1.5.x on loopback)
AGENTGATEWAY_URL=http://127.0.0.1:8080

# Google Workspace OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho Workplace OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# DPDP Act 2023 Statutory Consent
CURRENT_CONSENT_VERSION=2026.1

# Composio Platform API Key (Spec 04)
COMPOSIO_API_KEY=your_composio_api_key_here
