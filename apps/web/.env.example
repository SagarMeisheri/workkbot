# Workkbot Web Frontend Environment Configuration Template
# In local development: copy to .env.local and fill in values
# In production (GCP Cloud Run): mounted via Cloud Run environment / Secret Manager

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_REVIEWER_EMAIL=apple-reviewer@workkbot.in
NEXT_PUBLIC_REVIEWER_PASSWORD=<reviewer-demo-password>
