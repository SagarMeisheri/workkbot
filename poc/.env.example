# ==========================================
# Workkbot Local PoC Environment Settings
# ==========================================

# Execution Mode: Strict live API execution with dynamic OAuth tool discovery
WORKKBOT_EXECUTION_MODE=live

# Required: Google Gemini API Key for Google ADK 2.0 LlmAgent reasoning
GEMINI_API_KEY=

# Google Workspace OAuth 2.0 Credentials (for live mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# Zoho Suite OAuth 2.0 Credentials (for live mode)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8501
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=
ZOHO_DOMAIN=zoho.in

# SQLite Session Persistence (ADK 2.0 DatabaseSessionService)
SESSION_DB_URL=sqlite+aiosqlite:///poc_sessions.db

# Inbound Webhook Listener (FastAPI)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000

# Privacy & Compliance Guardrails
ENABLE_PRESIDIO_PII_MASKING=true
ENABLE_INJECTION_SHIELD=true
REQUIRE_HITL_FOR_WRITES=true
